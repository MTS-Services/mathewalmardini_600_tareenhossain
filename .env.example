# Frontend API base (used by address autocomplete, form submit, uploads)
# Local: create .env.local with http://localhost:3000/api
# Production builds use .env.production (https://api.b-spoke.com.au/api)
VITE_API_BASE_URL=https://api.b-spoke.com.au/api

# Optional
VITE_BUSINESS_EMAIL=your-business-email@example.com
