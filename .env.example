# EmailJS Configuration
# Get your credentials from https://www.emailjs.com/

# Step 1: Sign up at https://www.emailjs.com/
# Step 2: Add an email service (Gmail, Outlook, etc.)
# Step 3: Create an email template
# Step 4: Get your Public Key from Account settings
# Step 5: Replace the values in BookConsultation.jsx with your actual credentials

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_BUSINESS_EMAIL=your-business-email@example.com
