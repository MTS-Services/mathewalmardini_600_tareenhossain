---
import "../index.css";

const {
  title = "Home Renovations Melbourne | B-Spoke Builders",
  description = "B-Spoke - Kitchen and Bathroom Renovation Specialists in Australia. Explore our stunning portfolio of transformations.",
  path,
  // Home only: paint the hero poster before React boots
  lcpHero = false,
} = Astro.props;

const canonical = path && new URL(path, Astro.site).href;
const HERO_POSTER =
  "https://media.b-spoke.com.au/form_images/1789534057591-5a01b8d3f3acf766.webp?v=2";
const FONTS_URL =
  "https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://media.b-spoke.com.au" crossorigin />
    <link rel="dns-prefetch" href="https://media.b-spoke.com.au" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {lcpHero && <link rel="preload" as="image" href={HERO_POSTER} fetchpriority="high" />}
    <link rel="stylesheet" href={FONTS_URL} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {
      lcpHero && (
        <style is:inline>
          /* Critical hero shell — paints before React boots.
             On mobile it must cover at least the area of React's hero image (8px inset,
             running past the bottom edge), or React's copy becomes a new, late LCP.
             The 7px top inset makes it 1px taller so it also wins when both paint
             in the same frame. */
          #lcp-hero {
            position: fixed;
            inset: 0;
            z-index: 9999;
            margin: 0;
            padding: 7px 8px 0;
            box-sizing: border-box;
            overflow: hidden;
            background: #f4efe6;
            pointer-events: none;
          }
          #lcp-hero img {
            display: block;
            width: 100%;
            height: 100vh;
            object-fit: cover;
            border-radius: 1rem;
          }
          @media (min-width: 1025px) {
            #lcp-hero {
              padding: 20px;
            }
            #lcp-hero img {
              height: 100%;
              border-radius: 48px;
            }
          }
          #lcp-hero.is-hidden {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease;
          }
        </style>
      )
    }
    <!-- Defer analytics until the page has rendered so they don't compete with LCP -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      function loadAnalytics() {
        if (loadAnalytics.done) return;
        loadAnalytics.done = true;
        var gtm = document.createElement('script');
        gtm.async = true;
        gtm.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-NM53NVKS';
        document.head.appendChild(gtm);
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-B36DLTKR9E';
        document.head.appendChild(ga);
        gtag('js', new Date());
        gtag('config', 'G-B36DLTKR9E');
      }
      // Window load fires before the React islands render (their code is imported
      // dynamically), so also wait for every island to render, then for idle time.
      window.addEventListener('load', function () {
        var whenIdle = function () {
          if ('requestIdleCallback' in window) requestIdleCallback(loadAnalytics, { timeout: 2000 });
          else setTimeout(loadAnalytics, 200);
        };
        var pending = document.querySelectorAll('astro-island[ssr]');
        var left = pending.length;
        if (!left) return whenIdle();
        pending.forEach(function (island) {
          island.addEventListener('astro:hydrate', function () {
            if (--left === 0) whenIdle();
          }, { once: true });
        });
        setTimeout(loadAnalytics, 8000); // in case an island never renders
      });
    </script>
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NM53NVKS"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    {
      lcpHero && (
        <div id="lcp-hero" aria-hidden="true">
          <img
            src={HERO_POSTER}
            alt=""
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="sync"
            elementtiming="lcp-hero"
          />
        </div>
      )
    }

    <div id="root"><slot /></div>

    {
      lcpHero && (
        <script is:inline>
          /* Fallback: if React never mounts the hero (error), clear the shell. */
          window.setTimeout(function () {
            var el = document.getElementById('lcp-hero');
            if (el) el.remove();
          }, 8000);
        </script>
      )
    }
  </body>
</html>
